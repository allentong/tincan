[
  {
    "name": "claude",
    "bin": "claude",
    "cmd": [
      "claude",
      "-p",
      "--allowedTools",
      "Bash(tincan inbox:*)",
      "Bash(tincan reply:*)"
    ],
    "stdin": "prompt",
    "check": [
      "claude",
      "--version"
    ]
  },
  {
    "name": "claude-haiku",
    "profile": "claude",
    "bin": "claude",
    "cmd": [
      "claude",
      "-p",
      "--model",
      "claude-haiku-4-5-20251001",
      "--allowedTools",
      "Bash(tincan inbox:*)",
      "Bash(tincan reply:*)"
    ],
    "stdin": "prompt",
    "check": [
      "claude",
      "--version"
    ]
  },
  {
    "name": "codex",
    "bin": "codex",
    "cmd": [
      "codex",
      "exec",
      "--skip-git-repo-check",
      "-s",
      "workspace-write",
      "-C",
      "{team}",
      "{prompt}"
    ],
    "check": [
      "codex",
      "--version"
    ]
  },
  {
    "name": "grok",
    "bin": "grok",
    "cmd": [
      "grok",
      "-p",
      "{prompt}"
    ],
    "check": [
      "grok",
      "--version"
    ]
  },
  {
    "name": "opencode-zen",
    "profile": "opencode",
    "bin": "opencode",
    "cmd": [
      "opencode",
      "run",
      "--dir",
      "{team}",
      "-m",
      "opencode/{model}",
      "{prompt}"
    ],
    "model": "big-pickle",
    "check": [
      "opencode",
      "--version"
    ]
  },
  {
    "name": "opencode-openrouter",
    "profile": "opencode",
    "bin": "opencode",
    "requires_env": [
      "OPENROUTER_API_KEY"
    ],
    "cmd": [
      "opencode",
      "run",
      "--dir",
      "{team}",
      "-m",
      "openrouter/{model}",
      "{prompt}"
    ],
    "model": "qwen/qwen3.8-27b:free",
    "check": [
      "opencode",
      "--version"
    ],
    "free_only": true
  }
]
